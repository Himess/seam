# Copy to .env (never committed) and run: chmod 600 .env
# scripts/relay-feed.sh reads it from the repository root; for forge, run `set -a; . ../.env; set +a` in contracts/.

# Base Sepolia RPC, for the feeder and the deploy script.
RELAY_RPC_URL=https://sepolia.base.org
# A key that only ever holds Base Sepolia test ETH. Never print it. Prefer an encrypted keystore
# (`cast wallet import seam-feeder --interactive` writes one to ~/.foundry/keystores/seam-feeder) and a file holding
# its password: with a plain RELAYER_PRIVATE_KEY, cast gets the key on its command line, where other users of the
# machine can read it.
RELAYER_KEYSTORE=
RELAYER_PASSWORD_FILE=
RELAYER_PRIVATE_KEY=
# The deploy script's key (may be the same testnet-only key).
DEPLOYER_PRIVATE_KEY=
# Headers per transaction: 4 to 8 is the cheapest per header.
RELAY_BATCH=8
# Optional: source verification through Etherscan's V2 API.
ETHERSCAN_API_KEY=
# Optional: the live check in contracts/test/deployments.
BASE_SEPOLIA_RPC_URL=
